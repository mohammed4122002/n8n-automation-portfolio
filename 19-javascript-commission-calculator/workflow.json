    {
      "parameters": {
        "jsCode": "// Company commission policy, in one place and easy to change:\n// 1) Tiers are MARGINAL on net sales (sales - returns): first 5,000 at 3%, 5,000-10,000 at 5%, above 10,000 at 8%\n// 2) Bonus +200 when the rep brought 3 or more new clients\n// 3) If returns exceed 10% of sales, the commission is cut by 50%\n// 4) Monthly cap: 2,000\nconst TIERS = [\n  { upTo: 5000, rate: 0.03 },\n  { upTo: 10000, rate: 0.05 },\n  { upTo: Infinity, rate: 0.08 },\n];\nconst NEW_CLIENT_BONUS = 200;\nconst NEW_CLIENT_MIN = 3;\nconst RETURN_LIMIT = 0.10;\nconst PENALTY_FACTOR = 0.5;\nconst CAP = 2000;\n\nreturn $input.all().map((item) => {\n  const { rep, sales = 0, returns = 0, new_clients = 0 } = item.json;\n  const net = Math.max(0, sales - returns);\n\n  let tiered = 0;\n  let lower = 0;\n  for (const t of TIERS) {\n    if (net <= lower) break;\n    tiered += (Math.min(net, t.upTo) - lower) * t.rate;\n    lower = t.upTo;\n  }\n\n  const notes = [];\n  let commission = tiered;\n  if (new_clients >= NEW_CLIENT_MIN) {\n    commission += NEW_CLIENT_BONUS;\n    notes.push('مكافأة عملاء جدد +200');\n  }\n  const returnRate = sales > 0 ? returns / sales : 0;\n  if (returnRate > RETURN_LIMIT) {\n    commission *= PENALTY_FACTOR;\n    notes.push('مرتجعات ' + Math.round(returnRate * 100) + '% تخصم نصف العمولة');\n  }\n  if (commission > CAP) {\n    commission = CAP;\n    notes.push('وصل للحد الأعلى 2000');\n  }\n\n  return {\n    json: {\n      rep,\n      sales,\n      net_sales: net,\n      tiered_commission: Math.round(tiered),\n      commission: Math.round(commission),\n      notes: notes.length ? notes.join(' | ') : 'عمولة الشرائح فقط',\n    },\n  };\n});"
      },
