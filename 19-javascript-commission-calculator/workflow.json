            },
            {
              "id": "r6",
              "name": "verdict",
              "type": "string",
              "value": "={{ \"No-code حسب نسبة ثابتة على كامل المبيعات فدفع \" + $json.nocode_total_commission + \"، بينما سياسة الشركة الحقيقية بالكود (شرائح تصاعدية + مكافأة + خصم مرتجعات + حد أعلى) تعطي \" + $json.code_total_commission + \". الفرق \" + ($json.nocode_total_commission - $json.code_total_commission) + \" في شهر واحد.\" }}"
            },
            {
              "id": "r7",
              "name": "rule_of_thumb",
              "type": "string",
              "value": "No-code: عندما تكون العمولة نسبة واحدة أو شرائح بسيطة تراها بالعين على الكانفس. Code: عندما تتراكم الشروط (شرائح تصاعدية، مكافآت، خصومات، حد أعلى) وتريد المعادلة كلها في مكان واحد سهل التعديل."
            }
