    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst brief = $('Build Research Brief').first().json;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst icons = { post: '📝', carousel: '🎠', video: '🎬', 'short video': '🎬', poll: '📊', story: '📖' };\nconst lines = ['🗓️ <b>خطة محتوى الأسبوع</b> (يبدأ ' + brief.weekLabel + ')', '📰 اعتمدت على ' + brief.headlineCount + ' خبرًا حديثًا', ''];\nrows.forEach(r => {\n  lines.push((icons[String(r.format).toLowerCase()] || '💡') + ' <b>' + esc(r.day) + ': ' + esc(r.title) + '</b>');\n  lines.push('   🪝 ' + esc(r.hook));\n  lines.push('   🏷️ ' + esc(r.pillar) + ' · ' + esc(r.format) + (r.source ? ' · <a href=\"' + esc(r.source) + '\">المصدر</a>' : ''));\n  lines.push('');\n});\nlines.push('✅ حُفظت الأفكار في تبويب Ideas. انقل ما توافق عليه إلى Posts ليُنشر تلقائيًا (مشروع 07).');\nreturn [{ json: { chatId: brief.telegramChatId, text: lines.join('\\n') } }];"
      },
