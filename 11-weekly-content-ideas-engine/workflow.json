    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst pillars = $('Read Content Pillars').all().map(i => i.json).filter(p => p.Pillar);\nconst since = $now.minus({ days: 10 });\nconst seen = new Set();\nconst headlines = $('Read Trend Feeds').all().map(i => i.json)\n  .filter(h => h.title && h.link && !seen.has(h.title) && seen.add(h.title))\n  .filter(h => { const d = DateTime.fromISO(String(h.isoDate || h.pubDate || '')); return !d.isValid || d >= since; })\n  .slice(0, 25);\nconst past = $('Read Past Ideas').all().map(i => i.json.Title).filter(Boolean).slice(-40);\n\nconst pillarsText = pillars.length\n  ? pillars.map(p => '- ' + p.Pillar + (p.Description ? ': ' + p.Description : '') + (p.Weight ? ' (weight ' + p.Weight + ')' : '')).join('\\n')\n  : '- تعليم n8n خطوة بخطوة\\n- قصص قبل وبعد لمشاريع صغيرة\\n- كود مقابل نو كود\\n- أخبار الذكاء الاصطناعي بتطبيق عملي';\nconst trendsText = headlines.length ? headlines.map((h, i) => (i + 1) + '. ' + h.title + ' — ' + h.link).join('\\n') : '(no fresh headlines this week)';\nconst pastText = past.length ? past.map(t => '- ' + t).join('\\n') : '(none yet)';\n\nreturn [{ json: { ...cfg, pillarsText, trendsText, pastText, headlineCount: headlines.length, weekLabel: $now.plus({ weeks: 1 }).startOf('week').toFormat('yyyy-LL-dd') } }];"
      },
      "id": "ae83c1b1-610d-4b3c-9aa5-104dc7102310",
      "name": "Build Research Brief",
