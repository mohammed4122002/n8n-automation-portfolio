    {
      "parameters": {
        "promptType": "define",
        "text": "=Niche: {{ $json.niche }}\nAudience: {{ $json.audience }}\nBrand voice: {{ $json.voice }}\nNumber of ideas: {{ $json.ideasCount }} (one per day, Sunday to Saturday)\n\nContent pillars:\n{{ $json.pillarsText }}\n\nThis week's trending headlines:\n{{ $json.trendsText }}\n\nIdeas already used (do NOT repeat or paraphrase):\n{{ $json.pastText }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a LinkedIn content strategist for the Arab tech scene. Produce a balanced weekly plan in Arabic: spread ideas across the pillars by weight, mix formats (post, carousel, short video, poll, story), and connect at least 2 ideas to a real headline from the list (put its URL in inspired_by, else empty string). Hooks must be specific and under 15 words, no clickbait, no fake numbers. Each outline has exactly 3 points. Hashtags: 3 max, mixed Arabic/English."
            }
          ]
        },
        "batching": {}
      },
