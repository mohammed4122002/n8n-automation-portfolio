      "id": "d9202cbf-a58f-4766-ae97-25051ee2a86f",
      "name": "Read Past Ideas",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        672,
        592
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
