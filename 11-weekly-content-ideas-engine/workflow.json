    {
      "parameters": {
        "jsCode": "const ideas = ($input.first().json.output || {}).ideas || [];\nconst start = $now.plus({ weeks: 1 }).startOf('week').minus({ days: 1 });\nconst week = start.toFormat('kkkk-WW');\nreturn ideas.map((idea, i) => ({ json: {\n  ideaId: 'IDEA-' + week + '-' + (i + 1),\n  suggestedDate: start.plus({ days: i }).set({ hour: 9, minute: 30 }).toFormat('yyyy-LL-dd HH:mm'),\n  day: idea.day || '',\n  pillar: idea.pillar || '',\n  title: idea.title || '',\n  hook: idea.hook || '',\n  angle: idea.angle || '',\n  format: idea.format || 'post',\n  outline: (idea.outline || []).map((p, n) => (n + 1) + ') ' + p).join('  '),\n  cta: idea.cta || '',\n  hashtags: idea.hashtags || '',\n  source: idea.inspired_by || '',\n  status: 'idea'\n} }));"
      },
