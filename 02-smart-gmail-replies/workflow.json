    {
      "parameters": {
        "jsCode": "const labels = $('Get Labels').all().map(i => i.json);\nconst findLabelId = (name) => { const l = labels.find(x => String(x.name || '').toLowerCase() === name); return l ? l.id : ''; };\nconst autoRepliedLabelId = findLabelId('auto-replied');\nconst spamLabelId = findLabelId('spam-filtered');\n\nfunction parseFrom(f) {\n  if (f && typeof f === 'object' && Array.isArray(f.value) && f.value.length) {\n    return { name: f.value[0].name || '', email: String(f.value[0].address || '').toLowerCase() };\n  }\n  const s = String((f && f.text) || f || '');\n  const m = s.match(/^(.*?)<([^>]+)>/);\n  if (m) return { name: m[1].replace(/\"/g, '').trim(), email: m[2].trim().toLowerCase() };\n  return { name: '', email: s.trim().toLowerCase() };\n}\n\nfunction stripHtml(h) {\n  return String(h || '')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/p>/gi, '\\n')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"');\n}\n\nfunction stripQuoted(t) {\n  const lines = String(t || '').split(/\\r?\\n/);\n  const out = [];\n  for (const line of lines) {\n    const l = line.trim();\n    if (/^On .+wrote:$/i.test(l) || /^-{2,}\\s*Original Message/i.test(l) || /^From:\\s/i.test(l) || /كتب.*:$/.test(l)) break;\n    if (l.startsWith('>')) continue;\n    out.push(line);\n  }\n  return out.join('\\n').replace(/[ \\t]+/g, ' ').replace(/\\n{3,}/g, '\\n\\n').trim();\n}\n\nreturn $('Config').all().map((item, idx) => {\n  const e = item.json;\n  const sender = parseFrom(e.from || e.From);\n  const subject = e.subject || e.Subject || '(no subject)';\n  const rawText = e.text ? e.text : (e.html ? stripHtml(e.html) : (e.snippet || ''));\n  const body = stripQuoted(rawText).slice(0, 1500);\n  const arabic = (body + ' ' + subject).match(/[\\u0600-\\u06FF]/g) || [];\n  const latin = (body + ' ' + subject).match(/[A-Za-z]/g) || [];\n  const lang = arabic.length > latin.length ? 'ar' : 'en';\n  const headers = e.headers || {};\n  const headerKeys = Object.keys(headers).map(k => k.toLowerCase());\n  const labelIds = e.labelIds || [];\n  const myEmail = String(e.myEmail || '').trim().toLowerCase();\n  return {\n    json: {\n      messageId: e.id,\n      threadId: e.threadId,\n      senderName: sender.name || sender.email,\n      senderEmail: sender.email,\n      subject: subject,\n      body: body,\n      lang: lang,\n      isNoReply: /(no-?reply|do-?not-?reply|mailer-daemon|postmaster)/i.test(sender.email),\n      hasListUnsubscribe: headerKeys.includes('list-unsubscribe') || Boolean(e['list-unsubscribe']),\n      isFromMe: myEmail !== '' && sender.email === myEmail,\n      alreadyLabeled: (autoRepliedLabelId !== '' && labelIds.includes(autoRepliedLabelId)) || (spamLabelId !== '' && labelIds.includes(spamLabelId)),\n      autoRepliedLabelId: autoRepliedLabelId,\n      spamLabelId: spamLabelId,\n      myName: e.myName,\n      businessName: e.businessName,\n      signature: e.signature,\n      autoSendTypes: e.autoSendTypes || [],\n      telegramChatId: e.telegramChatId,\n      meetingSlots: e.meetingSlots,\n    },\n    pairedItem: { item: 0 },\n  };\n});"
      },
