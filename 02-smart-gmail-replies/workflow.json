    {
      "parameters": {
        "promptType": "define",
        "text": "=From: {{ $json.senderName }} <{{ $json.senderEmail }}>\nSubject: {{ $json.subject }}\n\n{{ $json.body }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You classify incoming business emails. Choose exactly one type:\n- inquiry: a general question about services, products, or how something works\n- complaint: the sender is unhappy, reports a problem, delay, or bad experience\n- quote_request: asks for a price, quote, estimate, or cost\n- meeting_request: asks for a call, meeting, or appointment\n- spam: newsletters, marketing, promotions, cold sales pitches, phishing, or irrelevant mass mail\nUrgency: high if the sender is angry, mentions a deadline within days, or a blocking problem; medium if they expect a reply soon; otherwise low.\nSummary: one short line in English.\nThe email may be in Arabic or English."
            }
          ]
        },
        "batching": {}
      },
