    {
      "parameters": {
        "jsCode": "const d = $('DocType Folder ID').first().json;\nconst names = $input.all().map((i) => i.json.name).filter((n) => !!n);\nconst dot = d.newName.lastIndexOf('.');\nconst base = d.newName.slice(0, dot);\nconst ext = d.newName.slice(dot);\nlet finalName = d.newName;\nlet n = 2;\nwhile (names.indexOf(finalName) >= 0) {\n  finalName = base + '_' + n + ext;\n  n++;\n}\nreturn [{ json: Object.assign({}, d, { finalName: finalName }), binary: $('Build Filename and Path').first().binary }];"
      },
