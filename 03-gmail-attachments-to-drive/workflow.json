      "parameters": {
        "jsCode": "const rows = $input.all().map((i) => i.json).filter((r) => r.ok);\nconst groups = {};\nfor (const r of rows) {\n  if (!groups[r.messageId]) {\n    groups[r.messageId] = { messageId: r.messageId, subject: r.subject, telegramChatId: r.telegramChatId, folderLink: r.folderLink, names: [] };\n  }\n  groups[r.messageId].names.push(r.finalName);\n}\nreturn Object.values(groups).map((g) => ({ json: { messageId: g.messageId, subject: g.subject, telegramChatId: g.telegramChatId, folderLink: g.folderLink, count: g.names.length, namesList: g.names.join('\\n') } }));"
