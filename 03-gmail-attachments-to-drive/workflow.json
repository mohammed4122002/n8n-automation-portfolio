    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Prepare Text').item.json;\nconst ai = $json.output || {};\nconst clean = (s) => String(s || '').replace(/[\\\\/:*?\"<>|#%&{}$!'@+=\\[\\]]/g, '').replace(/\\s+/g, '_').replace(/_+/g, '_').replace(/^_|_$/g, '');\nconst types = ['invoice', 'contract', 'report', 'receipt', 'id_document', 'other'];\nconst docType = types.indexOf(ai.docType) >= 0 ? ai.docType : 'other';\nlet date = /^\\d{4}-\\d{2}-\\d{2}$/.test(String(ai.docDate || '')) ? ai.docDate : '';\nif (!date) {\n  const d = new Date(src.date);\n  date = isNaN(d.getTime()) ? new Date().toISOString().slice(0, 10) : d.toISOString().slice(0, 10);\n}\nconst company = clean(ai.company) || 'Unknown';\nconst shortTitle = clean(ai.shortTitle) || 'Document';\nconst newName = [date, company, docType, shortTitle].join('_') + '.' + src.extension;\nconst month = date.slice(0, 7);\nreturn {\n  json: Object.assign({}, src, {\n    docType: docType,\n    company: company,\n    docDate: date,\n    shortTitle: shortTitle,\n    newName: newName,\n    month: month,\n    folderPath: month + ' / ' + docType,\n  }),\n  binary: $('Filter Files').item.binary,\n};"
      },
