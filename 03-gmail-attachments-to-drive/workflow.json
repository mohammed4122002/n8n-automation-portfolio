    {
      "parameters": {
        "jsCode": "const out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const j = items[i].json;\n  const bin = items[i].binary || {};\n  const from = (j.from && j.from.value && j.from.value[0]) || {};\n  const mimeToExt = { 'application/pdf': 'pdf', 'image/png': 'png', 'image/jpeg': 'jpg', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document': 'docx', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': 'xlsx' };\n  for (const key of Object.keys(bin)) {\n    const b = bin[key];\n    const buf = await this.helpers.getBinaryDataBuffer(i, key);\n    const name = b.fileName || key;\n    let ext = name.indexOf('.') >= 0 ? name.split('.').pop().toLowerCase() : '';\n    if (!ext) ext = mimeToExt[b.mimeType] || '';\n    if (ext === 'jpeg') ext = 'jpg';\n    out.push({\n      json: {\n        messageId: j.id,\n        senderName: from.name || '',\n        senderEmail: from.address || '',\n        subject: j.subject || '',\n        date: j.date || '',\n        originalName: name,\n        extension: ext,\n        mimeType: b.mimeType || '',\n        sizeBytes: buf.length,\n        isImage: ext === 'png' || ext === 'jpg',\n        telegramChatId: j.telegramChatId,\n        allowedTypes: j.allowedTypes,\n        maxSizeMB: j.maxSizeMB,\n      },\n      binary: { data: b },\n    });\n  }\n}\nreturn out;"
      },
