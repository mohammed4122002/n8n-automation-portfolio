      "id": "91af4bda-c2f2-45aa-ada9-d75bd00907e7",
      "name": "Fetch Product Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        496,
        352
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Pair each fetched page with its watchlist row and shrink the HTML to the parts that carry the price.\nconst rows = $('Get Watchlist').all();\nreturn $input.all().map((item, idx) => {\n  const row = rows[idx].json;\n  const html = String(item.json.data || '');\n  const ld = [...html.matchAll(/<script[^>]*ld\\+json[^>]*>([\\s\\S]*?)<\\/script>/gi)].map(m => m[1]).join(' ').slice(0, 3000);\n  const meta = [...html.matchAll(/<meta[^>]+price[^>]*>/gi)].map(m => m[0]).join(' ').slice(0, 1000);\n  const text = html\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .slice(0, 5000);\n  return {\n    json: {\n      row_id: row.id,\n      product_name: row.product_name,\n      product_url: row.product_url,\n      target_price: Number(row.target_price) || 0,\n      previous_price: Number(row.last_price) || 0,\n      lowest_price: Number(row.lowest_price) || 0,\n      page_text: 'STRUCTURED DATA: ' + ld + '\\nMETA: ' + meta + '\\nPAGE TEXT: ' + text,\n    },\n  };\n});"
      },
      "id": "f16df336-282a-4802-91f8-2d5838eb77cf",
      "name": "Prepare Page Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        352
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5.4-mini",
          "cachedResultName": "GPT-5.4-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You extract the current selling price of the main product from web page content. Reply with ONLY the number: no currency symbol, no thousands separator, dot as decimal point. Prefer structured data over page text, and the current price over the old crossed-out price. If no price can be found, reply 0."
            },
            {
              "content": "=Product: {{ $json.product_name }}\n\n{{ $json.page_text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 50
        }
      },
      "id": "fc132dbb-60fe-4c99-ba5a-c606f5eaf166",
      "name": "Extract Price With AI",
