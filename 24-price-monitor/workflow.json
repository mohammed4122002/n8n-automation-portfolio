            },
            {
              "id": "a5",
              "name": "previous_price",
              "type": "number",
              "value": "={{ $(\"Prepare Page Text\").item.json.previous_price }}"
            },
            {
              "id": "a6",
              "name": "new_price",
              "type": "number",
              "value": "={{ Number(String($json.output[0].content[0].text).replace(/[^0-9.]/g, \"\")) || 0 }}"
            },
            {
              "id": "a7",
              "name": "lowest_price",
              "type": "number",
              "value": "={{ (() => { const n = Number(String($json.output[0].content[0].text).replace(/[^0-9.]/g, \"\")) || 0; const l = $(\"Prepare Page Text\").item.json.lowest_price; return n > 0 ? (l > 0 ? Math.min(l, n) : n) : l; })() }}"
            },
            {
              "id": "a8",
              "name": "reason",
              "type": "string",
              "value": "={{ (() => { const n = Number(String($json.output[0].content[0].text).replace(/[^0-9.]/g, \"\")) || 0; const p = $(\"Prepare Page Text\").item.json.previous_price; const t = $(\"Prepare Page Text\").item.json.target_price; if (n <= 0) return \"\"; if (n <= t) return \"target\"; if (p > 0 && n < p) return \"drop\"; return \"\"; })() }}"
            }
          ]
        },
        "options": {}
      },
