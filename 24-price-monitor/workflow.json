      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "row_id",
              "type": "number",
              "value": "={{ $(\"Prepare Page Text\").item.json.row_id }}"
            },
            {
              "id": "a2",
