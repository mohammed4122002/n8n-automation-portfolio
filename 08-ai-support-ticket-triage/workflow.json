    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"channel\": \"manual\",\n  \"name\": \"سارة أحمد\",\n  \"email\": \"sara@example.com\",\n  \"chatId\": \"\",\n  \"message\": \"طلبت جهاز يوم 12 ولم يصل حتى الآن، وكل مرة أتصل لا أحد يرد. إذا لم يُحل الموضوع اليوم سألغي الطلب وأطلب استرداد المبلغ.\"\n}",
        "options": {}
      },
      "id": "1c9d01f9-6cf4-4ce1-8a6e-297f33cb2a6a",
      "name": "Sample Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        720
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst rand = Math.random().toString(36).slice(2, 6).toUpperCase();\nconst message = String(j.message || '').replace(/\\s+/g, ' ').trim().slice(0, 4000);\nreturn { json: {\n  ...j,\n  ticketId: 'TCK-' + $now.toFormat('yyLLdd') + '-' + rand,\n  createdAt: $now.toFormat('yyyy-LL-dd HH:mm'),\n  message: message || '(رسالة فارغة)',\n  name: String(j.name || 'Customer').trim(),\n  email: String(j.email || '').trim().toLowerCase()\n} };"
      },
      "id": "07e12ffb-03e1-4ae5-ad91-163cdf43986d",
      "name": "Prepare Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        528
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Channel: {{ $json.channel }}\nCustomer name: {{ $json.name }}\nMessage:\n\"\"\"{{ $json.message }}\"\"\"",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are the triage engine of a customer support desk for {{ $json.businessName }}.\nClassify the customer message.\n\ncategory: one of complaint | refund | order | inquiry | spam | other\n- complaint: unhappy with a product, delay, staff or service\n- refund: asks to cancel or get money back\n- order: wants to buy, book or place an order\n- inquiry: a question (price, hours, how-to, availability)\n- spam: ads, links, nonsense, unrelated promotions\npriority: urgent | high | normal | low (urgent = legal threat, safety, payment taken without service, very angry customer)\nsentiment: angry | negative | neutral | positive\nlanguage: ISO code of the customer message (ar, en, ...)\nsummary: ONE short Arabic sentence\nsuggested_reply: a polite reply in the customer language, max 80 words. Never invent prices, dates or policies; if you do not know, say a team member will follow up.\nconfidence: 0-1\nreasoning: one short English sentence\n\nExamples:\n\"وين طلبي؟ صار لي أسبوع\" -> complaint, high, negative\n\"How much is the monthly plan?\" -> inquiry, normal, neutral\n\"بدي ألغي الاشتراك وترجعولي المصاري\" -> refund, high, negative\n\"Buy followers cheap!!! bit.ly/x\" -> spam, low, neutral"
            }
          ]
        },
        "batching": {}
      },
      "id": "ffbe5774-a70c-4cd3-9402-0bc32625aa59",
      "name": "Classify Message",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        896,
        528
      ]
    },
    {
