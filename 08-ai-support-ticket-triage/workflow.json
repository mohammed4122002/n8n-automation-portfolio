    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"category\": \"complaint\",\n  \"priority\": \"high\",\n  \"sentiment\": \"angry\",\n  \"language\": \"ar\",\n  \"summary\": \"ملخص عربي في جملة واحدة\",\n  \"suggested_reply\": \"رد مقترح بلغة العميل\",\n  \"confidence\": 0.92,\n  \"reasoning\": \"why this category\"\n}"
      },
      "id": "110aa9ac-ebc2-4bde-a449-017d1cff4f84",
      "name": "Ticket Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1032,
        760
      ]
    },
    {
      "parameters": {
        "jsCode": "const tickets = $('Prepare Ticket').all();\nconst slaHours = { urgent: 1, high: 4, normal: 24, low: 48 };\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst out = [];\n\n$input.all().forEach((item, i) => {\n  const t = tickets[i].json;\n  const ai = item.json.output || {};\n  let category = String(ai.category || 'other').toLowerCase();\n  let priority = String(ai.priority || 'normal').toLowerCase();\n  const sentiment = String(ai.sentiment || 'neutral').toLowerCase();\n  const confidence = Number(ai.confidence) || 0;\n\n  // Rule-based escalation on top of the AI decision\n  if (/محامي|شكوى رسمية|احتيال|نصب|lawyer|legal|fraud|police/i.test(t.message)) priority = 'urgent';\n  if (sentiment === 'angry' && ['complaint', 'refund'].includes(category) && priority !== 'urgent') priority = 'high';\n  if (category === 'spam') priority = 'low';\n  if (!slaHours[priority]) priority = 'normal';\n\n  const needsReview = category === 'other' || confidence < 0.6;\n  const autoAnswered = Boolean(t.autoAnswerInquiries) && category === 'inquiry' && confidence >= 0.8;\n  const dueAt = $now.plus({ hours: slaHours[priority] }).toFormat('yyyy-LL-dd HH:mm');\n  const isArabic = String(ai.language || 'ar').startsWith('ar');\n\n  let customerReply;\n  if (category === 'spam') customerReply = isArabic ? 'تم استلام رسالتك.' : 'Your message was received.';\n  else if (autoAnswered) customerReply = ai.suggested_reply + (isArabic ? '\\n\\nرقم التذكرة: ' : '\\n\\nTicket: ') + t.ticketId;\n  else customerReply = isArabic\n    ? 'شكرًا لتواصلك يا ' + t.name + '. استلمنا رسالتك برقم ' + t.ticketId + ' وسيتواصل معك فريقنا خلال ' + slaHours[priority] + ' ساعة كحد أقصى.'\n    : 'Thanks ' + t.name + '. We received your message (ticket ' + t.ticketId + ') and will get back to you within ' + slaHours[priority] + ' hours.';\n\n  const icon = { urgent: '🚨', high: '🔴', normal: '🟡', low: '🟢' }[priority];\n  const alertText = [\n    icon + ' <b>تذكرة جديدة ' + esc(t.ticketId) + '</b>',\n    '📂 ' + esc(category) + ' | ⚡ ' + esc(priority) + ' | 😶 ' + esc(sentiment),\n    '👤 ' + esc(t.name) + ' (' + esc(t.channel) + (t.email ? ' · ' + esc(t.email) : '') + ')',\n    '📝 ' + esc(ai.summary),\n    '⏰ الرد قبل: ' + dueAt,\n    '',\n    '<b>الرسالة:</b> ' + esc(t.message.slice(0, 600)),\n    '',\n    '<b>رد مقترح:</b> ' + esc(ai.suggested_reply)\n  ].join('\\n');\n\n  out.push({ json: {\n    ticketId: t.ticketId, createdAt: t.createdAt, channel: t.channel, name: t.name, email: t.email, chatId: t.chatId,\n    message: t.message, category, priority, sentiment, language: ai.language || '', summary: ai.summary || '',\n    suggestedReply: ai.suggested_reply || '', confidence, reasoning: ai.reasoning || '', slaHours: slaHours[priority], dueAt,\n    needsReview, autoAnswered, status: autoAnswered ? 'auto-answered' : (category === 'spam' ? 'closed' : 'open'),\n    customerReply, alertText, supportChatId: t.supportChatId, salesChatId: t.salesChatId\n  } });\n});\nreturn out;"
      },
