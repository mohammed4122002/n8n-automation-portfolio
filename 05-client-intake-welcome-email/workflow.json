    {
      "parameters": {
        "jsCode": "const TZ = 'Asia/Hebron';\nconst j = $input.first().json;\nconst raw = {\n  name: j['الاسم الكامل'],\n  email: j['البريد الإلكتروني'],\n  phone: j['رقم الهاتف'],\n  service: j['الخدمة المطلوبة'],\n  notes: j['ملاحظات'],\n};\nfunction s(v) { return String(v === undefined || v === null ? '' : v).trim(); }\nconst name = s(raw.name);\nconst email = s(raw.email).toLowerCase();\nconst rawPhone = s(raw.phone);\nconst hasPlus = rawPhone.charAt(0) === '+';\nconst digits = rawPhone.replace(/\\D/g, '');\nconst phone = (hasPlus ? '+' : '') + digits;\nconst service = s(raw.service) || 'أخرى';\nconst notes = s(raw.notes);\n\nconst errors = [];\nif (!name) errors.push('الاسم مفقود');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) errors.push('البريد الإلكتروني غير صالح');\nif (digits.length < 8) errors.push('رقم الهاتف يجب أن يحتوي على 8 أرقام على الأقل');\n\nconst parts = new Intl.DateTimeFormat('sv-SE', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(new Date());\nconst submittedAt = parts.replace(' ', 'T');\nconst datePart = submittedAt.slice(0, 10).split('-').join('');\nconst code = Math.random().toString(36).slice(2, 6).toUpperCase();\nconst clientId = 'CL-' + datePart + '-' + code;\n\nreturn [{ json: {\n  isValid: errors.length === 0,\n  errors: errors,\n  submittedAt: submittedAt,\n  clientId: clientId,\n  name: name, email: email, phone: phone, service: service, notes: notes,\n  raw: raw,\n} }];"
      },
