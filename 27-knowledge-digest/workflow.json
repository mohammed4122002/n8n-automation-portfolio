    {
      "parameters": {
        "jsCode": "const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst req = $('Read Message').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.title);\nlet msg;\nif (!req.search_term) {\n  msg = 'اكتب كلمة بعد الأمر، مثال: ابحث تسويق';\n} else if (!rows.length) {\n  msg = 'لا توجد نتائج في مكتبتك لكلمة: <b>' + esc(req.search_term) + '</b>';\n} else {\n  msg = '<b>نتائج البحث عن: ' + esc(req.search_term) + '</b> (' + rows.length + ')\\n\\n';\n  msg += rows.map((r, n) => {\n    const s = String(r.summary || '');\n    return (n + 1) + '. <b>' + esc(r.title) + '</b>\\n' + esc(s.length > 220 ? s.slice(0, 220) + '...' : s) + '\\n' + esc(r.source_url);\n  }).join('\\n\\n');\n}\nif (msg.length > 4000) msg = msg.slice(0, 3990) + '...';\nreturn [{ json: { chat_id: req.chat_id, message: msg } }];"
      },
