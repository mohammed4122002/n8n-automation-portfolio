    {
      "parameters": {
        "jsCode": "const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nreturn $input.all().map((item, i) => {\n  const o = item.json.output || {};\n  const src = $('Prepare Content').itemMatching(i).json;\n  const kind = src.source_type === 'youtube' ? 'فيديو يوتيوب' : 'مقال';\n  let msg = '<b>' + esc(o.title) + '</b>\\n<i>' + kind + '</i>\\n\\n';\n  msg += '<b>الملخص</b>\\n' + esc(o.summary) + '\\n\\n';\n  const points = o.key_points || [];\n  if (points.length) msg += '<b>أهم النقاط</b>\\n' + points.map((p) => '• ' + esc(p)).join('\\n') + '\\n\\n';\n  const quotes = o.quotes || [];\n  if (quotes.length) msg += '<b>اقتباسات</b>\\n' + quotes.map((q) => '« ' + esc(q) + ' »').join('\\n') + '\\n\\n';\n  const actions = o.action_items || [];\n  if (actions.length) msg += '<b>خطوات عملية</b>\\n' + actions.map((a) => '- ' + esc(a)).join('\\n') + '\\n\\n';\n  const tags = (o.tags || []).map((t) => '#' + esc(String(t).replace(/\\s+/g, '_'))).join(' ');\n  if (tags) msg += tags + '\\n\\n';\n  msg += 'تم الحفظ في مكتبتك. للبحث لاحقاً اكتب: ابحث كلمة';\n  if (msg.length > 4000) msg = msg.slice(0, 3990) + '...';\n  return { json: { chat_id: src.chat_id, message: msg } };\n});"
      },
