    {
      "parameters": {
        "jsCode": "// Generic flattener: works on ANY nesting depth without naming fields one by one.\n// Nested objects become snake_case columns (customer.contact.email -> customer_contact_email).\n// Each element of the \"items\" array becomes its own row, with order fields repeated.\nconst flatten = (obj, prefix, out) => {\n  for (const [key, value] of Object.entries(obj || {})) {\n    const col = prefix ? prefix + '_' + key : key;\n    if (value !== null && typeof value === 'object' && !Array.isArray(value)) {\n      flatten(value, col, out);\n    } else if (!Array.isArray(value)) {\n      out[col] = value;\n    }\n  }\n  return out;\n};\n\nconst rows = [];\nfor (const input of $input.all()) {\n  const orders = input.json.data?.orders || [];\n  for (const order of orders) {\n    const base = flatten(order, '', {});\n    const items = Array.isArray(order.items) && order.items.length ? order.items : [{}];\n    for (const item of items) {\n      const row = { ...base, ...flatten(item, 'item', {}) };\n      row.line_total = (Number(item.qty) || 0) * (Number(item.price) || 0) - (Number(item.discount) || 0);\n      rows.push(row);\n    }\n  }\n}\n\n// Same columns on every row: fill missing values with empty strings\nconst columns = [...new Set(rows.flatMap((r) => Object.keys(r)))];\nreturn rows.map((r) => {\n  const clean = {};\n  for (const c of columns) clean[c] = r[c] ?? '';\n  return { json: clean };\n});"
      },
