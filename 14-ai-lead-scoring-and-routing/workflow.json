    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Normalize and Rule Score').item.json;\nconst html = typeof $json.html === 'string' ? $json.html : '';\nconst title = (html.match(/<title[^>]*>([^<]*)<\\/title>/i) || [])[1] || '';\nconst desc = (html.match(/<meta[^>]+name=[\"']description[\"'][^>]+content=[\"']([^\"']*)/i) || [])[1] || '';\nconst text = html\n  .replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>|<noscript[\\s\\S]*?<\\/noscript>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;|&amp;|&quot;|&#39;/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 3000);\nreturn { json: { ...lead, websiteReachable: text.length > 100, websiteTitle: title.trim(), websiteDescription: desc.trim(), websiteText: text } };"
      },
      "id": "7d9f0d85-44eb-4900-989d-83996bd476ee",
      "name": "Website Snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        304
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Lead:\n- Name: {{ $json.name }} ({{ $json.role }})\n- Company: {{ $json.company }} | team size: {{ $json.size }}\n- Budget: {{ $json.budget }} | Timeline: {{ $json.timeline }}\n- Wants to automate: {{ $json.need }}\n\nWebsite ({{ $json.websiteReachable ? \"reachable\" : \"not reachable\" }}): {{ $json.websiteTitle }} — {{ $json.websiteDescription }}\n{{ $json.websiteText.slice(0, 2000) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You qualify inbound leads for a freelance automation studio (n8n, AI agents, WhatsApp/Telegram bots, Google Workspace automations).\nfit_score 0-100 = how well the need matches these services and how concrete/valuable it is. High: clear repetitive process, business context, measurable pain. Low: vague, homework, unrelated (e.g. logo design), or spam.\nWrite company_summary, use_case, recommended_service and personalized_opening in Arabic. The opening must reference something specific from the need or website; no flattery, no promises of prices.\nestimated_hours_saved_per_week: conservative integer estimate.\nred_flags: [] if none."
            }
          ]
        },
        "batching": {}
      },
