      "id": "f74601ff-84fd-4da8-af4b-605bb36412bf",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        304
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst email = String(j['البريد الإلكتروني'] || '').trim().toLowerCase();\nlet website = String(j['الموقع الإلكتروني'] || '').trim();\nif (website && !/^https?:\\/\\//i.test(website)) website = 'https://' + website;\nconst domain = email.split('@')[1] || '';\nconst freeMail = /^(gmail|yahoo|hotmail|outlook|icloud|live)\\./i.test(domain);\nif (!website && domain && !freeMail) website = 'https://' + domain;\n\nconst budget = j['الميزانية'] || '', timeline = j['متى تريد البدء؟'] || '', role = j['دورك'] || '', size = j['حجم الفريق'] || '';\nconst budgetPts = { 'أقل من 500$': 3, '500 - 2000$': 10, '2000 - 5000$': 15, 'أكثر من 5000$': 18 }[budget] ?? 0;\nconst timelinePts = { 'هذا الشهر': 12, 'خلال 1-3 أشهر': 7, 'أستكشف فقط': 2 }[timeline] ?? 0;\nconst rolePts = { 'مالك / مؤسس': 10, 'مدير': 7, 'موظف': 3, 'طالب': 0 }[role] ?? 0;\nconst ruleScore = Math.min(40, budgetPts + timelinePts + rolePts) - (freeMail ? 2 : 0);\n\nreturn { json: {\n  leadId: 'LEAD-' + $now.toFormat('yyLLdd-HHmmss'),\n  submittedAt: $now.toFormat('yyyy-LL-dd HH:mm'),\n  name: String(j['الاسم الكامل'] || '').trim(),\n  firstName: String(j['الاسم الكامل'] || '').trim().split(/\\s+/)[0],\n  email, company: String(j['اسم الشركة'] || '').trim(), website, role, size, budget, timeline,\n  need: String(j['ما الذي تريد أتمتته؟'] || '').trim(),\n  freeMail, ruleScore,\n  ruleBreakdown: 'budget ' + budgetPts + ' + timeline ' + timelinePts + ' + role ' + rolePts + (freeMail ? ' - 2 (free email)' : '')\n} };"
      },
      "id": "ee4b590d-1366-42e7-81c1-d657424099d7",
