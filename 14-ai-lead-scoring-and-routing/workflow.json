        "jsonSchemaExample": "{\n  \"fit_score\": 82,\n  \"industry\": \"عيادات أسنان\",\n  \"company_summary\": \"سطر واحد عن الشركة\",\n  \"use_case\": \"أتمتة حجز المواعيد والتذكير\",\n  \"recommended_service\": \"بوت حجوزات واتساب + تذكير تلقائي\",\n  \"estimated_hours_saved_per_week\": 10,\n  \"personalized_opening\": \"جملتان شخصيتان بالعربية\",\n  \"red_flags\": [\"...\"],\n  \"reasoning\": \"short English reasoning\"\n}"
