      "id": "e4033f6a-e426-4082-8544-8aa06d7d8a53",
      "name": "Lead Analysis Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1232,
        528
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Website Snapshot').item.json;\nconst ai = $json.output || {};\nconst cfg = $('Config').first().json;\nconst fit = Math.max(0, Math.min(100, Number(ai.fit_score) || 0));\nconst score = Math.round(lead.ruleScore + fit * 0.6);\nconst tier = score >= 70 ? 'hot' : score >= 45 ? 'warm' : 'cold';\nconst opening = ai.personalized_opening || ('شكرًا لتواصلك يا ' + lead.firstName + '.');\n\nconst sign = '\\n\\nتحياتي،\\n' + cfg.senderName + '\\n' + cfg.businessName;\nconst emails = {\n  hot: {\n    subject: lead.firstName + '، خطوة سريعة لأتمتة ' + (ai.use_case || 'عملك'),\n    body: 'مرحبًا ' + lead.firstName + '،\\n\\n' + opening + '\\n\\nبناءً على ما كتبته، أقترح: ' + (ai.recommended_service || '') + '.\\nأحب أن أريك كيف سيعمل على حالتك في مكالمة قصيرة (30 دقيقة):\\n' + cfg.bookingUrl + sign\n  },\n  warm: {\n    subject: 'فكرة لأتمتة ' + (ai.use_case || 'عملك') + ' في ' + lead.company,\n    body: 'مرحبًا ' + lead.firstName + '،\\n\\n' + opening + '\\n\\nجهزت لك أمثلة لأنظمة مشابهة بنيتها على n8n:\\n' + cfg.caseStudyUrl + '\\n\\nإذا أعجبتك الفكرة، احجز مكالمة متى ما ناسبك: ' + cfg.bookingUrl + sign\n  },\n  cold: {\n    subject: 'شكرًا لتواصلك مع ' + cfg.businessName,\n    body: 'مرحبًا ' + lead.firstName + '،\\n\\nشكرًا لاهتمامك بالأتمتة. هذه مكتبة workflows مجانية يمكنك البدء بها فورًا:\\n' + cfg.caseStudyUrl + '\\n\\nوعندما تصبح جاهزًا لمشروع، يسعدني أن نتحدث.' + sign\n  }\n};\n\nreturn { json: {\n  ...lead,\n  fitScore: fit, score, tier,\n  industry: ai.industry || '', companySummary: ai.company_summary || '', useCase: ai.use_case || '',\n  recommendedService: ai.recommended_service || '', hoursSaved: ai.estimated_hours_saved_per_week || 0,\n  redFlags: (ai.red_flags || []).join(' | '), reasoning: ai.reasoning || '',\n  emailSubject: emails[tier].subject, emailBody: emails[tier].body,\n  salesChatId: cfg.salesChatId\n} };"
      },
