    {
      "parameters": {
        "jsCode": "// Deterministic priority score (0-100). The AI model never changes it.\n// idle_points  (0-50): days_inactive / 30 * 50, capped at 50\n// value_points (0-30): amount / high_value_amount * 30, capped at 30\n// stage_points (0-20): fixed weight per stage (later stages = more at stake)\nconst cfg = $('Config').first().json;\nconst threshold = Number(cfg.inactivity_days) || 7;\nconst highValue = Number(cfg.high_value_amount) || 50000;\nconst maxDeals = Number(cfg.max_deals_per_run) || 50;\nconst closed = String(cfg.closed_stages || '').split(',').map((s) => s.trim().toLowerCase()).filter(Boolean);\nconst stageWeights = { lead: 4, new: 4, qualification: 8, discovery: 8, demo: 12, proposal: 16, negotiation: 20, contract: 20 };\nconst now = Date.now();\nconst out = [];\n\n$input.all().forEach((item, index) => {\n  const d = item.json || {};\n  if (Object.keys(d).length === 0) return;\n  try {\n    const stage = String(d.stage || '').trim().toLowerCase();\n    if (closed.includes(stage)) return;\n    if (!d.deal_id) throw new Error('Row has no deal_id');\n    const ts = new Date(d.last_activity_at).getTime();\n    if (isNaN(ts)) throw new Error('Invalid or missing last_activity_at');\n    const days = Math.floor((now - ts) / 86400000);\n    if (days < threshold) return;\n    const amount = Number(d.amount) || 0;\n    const idlePoints = Math.min(50, Math.round((days / 30) * 50));\n    const valuePoints = Math.min(30, Math.max(0, Math.round((amount / highValue) * 30)));\n    const stagePoints = Object.prototype.hasOwnProperty.call(stageWeights, stage) ? stageWeights[stage] : 10;\n    const score = Math.max(0, Math.min(100, idlePoints + valuePoints + stagePoints));\n    out.push({\n      json: {\n        deal_id: String(d.deal_id),\n        customer_name: d.customer_name || '',\n        stage,\n        amount,\n        currency: d.currency || 'ILS',\n        last_activity_at: new Date(ts).toISOString(),\n        next_step: d.next_step || '',\n        notes: d.notes || '',\n        days_inactive: days,\n        priority_score: score,\n        score_breakdown: { idle_points: idlePoints, value_points: valuePoints, stage_points: stagePoints },\n        scoring_error: '',\n      },\n      pairedItem: { item: index },\n    });\n  } catch (e) {\n    out.push({\n      json: { deal_id: String(d.deal_id || 'unknown'), customer_name: d.customer_name || '', scoring_error: e.message, priority_score: 0 },\n      pairedItem: { item: index },\n    });\n  }\n});\n\nout.sort((a, b) => b.json.priority_score - a.json.priority_score);\nreturn out.slice(0, maxDeals);"
      },
