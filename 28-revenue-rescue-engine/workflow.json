      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = ($json.body && typeof $json.body === 'object') ? $json.body : {};\nconst errors = [];\nconst str = (v) => (v === undefined || v === null) ? '' : String(v).trim();\n\n// Remove anything that looks like payment data or secrets from free text\nconst scrub = (text) => str(text)\n  .replace(/\\b\\d(?:[ -]?\\d){12,18}\\b/g, '[REDACTED_CARD]')\n  .replace(/\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b/g, '[REDACTED_IBAN]')\n  .replace(/\\b(cvv|cvc|cvv2)\\s*[:=]?\\s*\\d{3,4}\\b/gi, '$1: [REDACTED]')\n  .replace(/\\b(password|passwd|pwd|api[_-]?key|token|secret)\\s*[:=]\\s*\\S+/gi, '$1: [REDACTED]')\n  .slice(0, 2000);\n\nconst dealId = str(body.deal_id);\nconst customerName = str(body.customer_name);\nconst customerEmail = str(body.customer_email).toLowerCase();\nconst stage = str(body.stage).toLowerCase().replace(/\\s+/g, '_');\nconst currency = (str(body.currency) || 'ILS').toUpperCase();\n\nif (!dealId) errors.push('deal_id is required');\nelse if (dealId.length > 100 || !/^[A-Za-z0-9_.:-]+$/.test(dealId)) errors.push('deal_id must be up to 100 chars: letters, digits, _ . : -');\nif (!customerName) errors.push('customer_name is required');\nif (!customerEmail) errors.push('customer_email is required');\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(customerEmail)) errors.push('customer_email is not a valid email');\nif (!stage) errors.push('stage is required');\nif (!/^[A-Z]{3}$/.test(currency)) errors.push('currency must be a 3-letter code such as ILS');\n\nlet amount = null;\nif (body.amount === undefined || body.amount === null || body.amount === '') {\n  errors.push('amount is required');\n} else {\n  amount = typeof body.amount === 'number' ? body.amount : Number(String(body.amount).replace(/,/g, ''));\n  if (!Number.isFinite(amount)) errors.push('amount must be a number');\n  else if (amount < 0) errors.push('amount must be >= 0');\n}\n\nlet lastActivityIso = null;\nconst rawDate = str(body.last_activity_at);\nif (!rawDate) {\n  errors.push('last_activity_at is required (ISO date)');\n} else if (!/^\\d{4}-\\d{2}-\\d{2}/.test(rawDate) || isNaN(new Date(rawDate).getTime())) {\n  errors.push('last_activity_at must be a valid ISO date, e.g. 2026-11-01T10:00:00Z');\n} else {\n  const d = new Date(rawDate);\n  if (d.getTime() > Date.now() + 24 * 3600 * 1000) errors.push('last_activity_at cannot be in the future');\n  else lastActivityIso = d.toISOString();\n}\n\nconst allowed = ['deal_id', 'customer_name', 'customer_email', 'stage', 'amount', 'currency', 'last_activity_at', 'next_step', 'notes'];\nconst ignoredFields = Object.keys(body).filter((k) => !allowed.includes(k));\n\nreturn {\n  json: {\n    valid: errors.length === 0,\n    errors,\n    ignored_fields: ignoredFields,\n    deal: {\n      deal_id: dealId,\n      customer_name: customerName.slice(0, 200),\n      customer_email: customerEmail,\n      stage,\n      amount,\n      currency,\n      last_activity_at: lastActivityIso,\n      next_step: scrub(body.next_step),\n      notes: scrub(body.notes),\n    },\n  },\n};"
      },
