    {
      "parameters": {
        "jsCode": "// Regex extraction: ALL emails and ALL phones in every message.\n// Handles Arabic digits, \"name [at] domain [dot] com\" tricks, +970 / 00970 / 05x formats with spaces or dashes.\nconst toLatinDigits = (s) => s.replace(/[\\u0660-\\u0669]/g, (d) => String(d.charCodeAt(0) - 0x0660));\n\nconst EMAIL_RE = /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/g;\nconst PHONE_RE = /(?:\\+|00)?970[\\s-]?5\\d(?:[\\s-]?\\d){7}|05\\d(?:[\\s-]?\\d){7}/g;\n\nconst normalizePhone = (p) => {\n  let d = p.replace(/\\D/g, '');\n  if (d.startsWith('00')) d = d.slice(2);\n  if (d.startsWith('970')) d = '0' + d.slice(3);\n  return d;\n};\n\nreturn $input.all().map((item) => {\n  const text = toLatinDigits(String(item.json.text || ''))\n    .replace(/\\s*[\\[(]\\s*at\\s*[\\])]\\s*/gi, '@')\n    .replace(/\\s*[\\[(]\\s*dot\\s*[\\])]\\s*/gi, '.');\n\n  const emails = [...new Set((text.match(EMAIL_RE) || []).map((e) => e.toLowerCase()))];\n  const phones = [...new Set((text.match(PHONE_RE) || []).map(normalizePhone))];\n\n  return {\n    json: {\n      message_id: item.json.id,\n      channel: item.json.channel,\n      emails,\n      phones,\n      email_count: emails.length,\n      phone_count: phones.length,\n    },\n  };\n});"
      },
