    {
      "parameters": {
        "promptType": "define",
        "text": "=Today is {{ $now.toFormat(\"cccc yyyy-LL-dd\") }} (timezone {{ $now.zoneName }}).\n\nTranscript of a voice note:\n\"\"\"{{ $json.text }}\"\"\"",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You turn voice notes (Arabic dialects or English) into clear notes. Write everything in Arabic (Modern Standard), keep names and technical terms as spoken.\n- title: max 8 words\n- type: meeting | idea | reminder | brainstorm | other\n- summary: 2-6 short bullet points\n- decisions: only explicit decisions, else []\n- action_items: concrete tasks only. owner = person named, else \"أنا\". Convert relative dates (بكرا، الخميس الجاي، next week) to YYYY-MM-DD using today's date; if no date is mentioned use \"\". priority: high | normal | low.\nNever invent tasks, people or dates that are not in the transcript."
            }
          ]
        },
        "batching": {}
      },
      "id": "80110799-67f6-41a4-bfa7-935d47ff8c0b",
      "name": "Extract Summary and Tasks",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        944,
        400
