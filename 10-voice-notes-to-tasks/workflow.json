    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"title\": \"عنوان قصير\",\n  \"type\": \"meeting\",\n  \"summary\": [\"نقطة 1\", \"نقطة 2\"],\n  \"decisions\": [\"قرار 1\"],\n  \"action_items\": [\n    { \"task\": \"إرسال العرض للعميل\", \"owner\": \"محمد\", \"due_date\": \"2026-10-28\", \"priority\": \"high\" }\n  ],\n  \"language\": \"ar\"\n}"
      },
      "id": "d45dd8ca-30f4-4c3e-bd91-f5726c2ea6c2",
      "name": "Notes Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1072,
        624
      ]
    },
    {
      "parameters": {
        "jsCode": "const msg = $('Telegram Voice Note').first().json.message;\nconst transcript = $('Transcribe Audio').first().json.text || '';\nconst o = $input.first().json.output || {};\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst typeIcon = { meeting: '👥', idea: '💡', reminder: '⏰', brainstorm: '🧠' }[o.type] || '🗒️';\nconst tasks = (o.action_items || []).filter(t => t && t.task).map(t => ({\n  task: String(t.task).trim(),\n  owner: t.owner || 'أنا',\n  due_date: /^\\d{4}-\\d{2}-\\d{2}$/.test(t.due_date || '') ? t.due_date : '',\n  priority: t.priority || 'normal'\n}));\nconst duration = (msg.voice || msg.audio || {}).duration || 0;\n\nconst lines = [typeIcon + ' <b>' + esc(o.title || 'ملاحظة صوتية') + '</b>', '⏱️ ' + Math.floor(duration / 60) + ':' + String(duration % 60).padStart(2, '0') + ' دقيقة', '', '<b>الخلاصة:</b>'];\n(o.summary || []).forEach(s => lines.push('• ' + esc(s)));\nif ((o.decisions || []).length) { lines.push('', '<b>القرارات:</b>'); o.decisions.forEach(d => lines.push('✔️ ' + esc(d))); }\nif (tasks.length) {\n  lines.push('', '<b>المهام (' + tasks.length + '):</b>');\n  tasks.forEach(t => lines.push((t.priority === 'high' ? '🔴' : '☑️') + ' ' + esc(t.task) + ' — ' + esc(t.owner) + (t.due_date ? ' · 📅 ' + t.due_date : '')));\n  lines.push('', '✅ أُضيفت المهام إلى Google Tasks');\n}\nlines.push('', '<blockquote expandable>' + esc(transcript.slice(0, 2500)) + '</blockquote>');\n\nreturn [{ json: {\n  chatId: msg.chat.id,\n  messageId: msg.message_id,\n  user: msg.from ? (msg.from.username || msg.from.first_name) : '',\n  date: $now.toFormat('yyyy-LL-dd HH:mm'),\n  durationSec: duration,\n  title: o.title || '',\n  type: o.type || 'other',\n  summaryText: (o.summary || []).join(' | '),\n  decisionsText: (o.decisions || []).join(' | '),\n  transcript,\n  tasks,\n  taskCount: tasks.length,\n  telegramText: lines.join('\\n')\n} }];"
      },
