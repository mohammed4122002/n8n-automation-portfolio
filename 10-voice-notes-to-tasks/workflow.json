      "id": "833edb17-695c-4ada-9219-38c8d8c9dbb5",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        912,
        624
      ],
