    {
      "parameters": {
        "jsCode": "const raw = $('Read Raw Contacts').all().length;\nconst noCode = $('Remove Duplicates (No-code)').all().length;\nconst noCodeDropped = raw - $('Valid Email (No-code)').all().length;\nconst out = $('Clean, Validate and Merge (Code)').all().map(i => i.json);\nconst clean = out.filter(r => r.status === 'clean');\nconst rejected = out.filter(r => r.status === 'rejected');\nconst merged = clean.reduce((s, r) => s + (r.mergedCount - 1), 0);\nconst fixed = clean.filter(r => r.fixes).length;\nconst withPhone = clean.filter(r => r.phone).length;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst text = [\n  '🧹 <b>تقرير تنظيف بيانات العملاء</b> — ' + $now.toFormat('yyyy-LL-dd HH:mm'),\n  '',\n  '📥 صفوف خام: <b>' + raw + '</b>',\n  '',\n  '<b>⚙️ مسار No-code</b> (Set + Filter + Remove Duplicates)',\n  '• جهات اتصال نهائية: ' + noCode,\n  '• حُذف بسبب بريد غير صالح: ' + noCodeDropped + ' (حتى لو كان الهاتف صالحًا)',\n  '',\n  '<b>💻 مسار Code</b> (Code node واحد)',\n  '• جهات اتصال نظيفة: ' + clean.length,\n  '• تكرارات دُمجت (بالبريد أو الهاتف): ' + merged,\n  '• صفوف صُحّحت تلقائيًا: ' + fixed + ' (أخطاء نطاق، .con، أرقام عربية، مفتاح الدولة)',\n  '• أرقام بصيغة دولية: ' + withPhone,\n  '• مرفوض مع السبب: ' + rejected.length,\n  '',\n  '💡 <b>القاعدة:</b> No-code ممتاز للتنظيف البسيط والقواعد الواضحة. Code أفضل عندما تحتاج تصحيحًا ذكيًا ودمجًا متعدد المفاتيح وتقريرًا بالأسباب.'\n];\nif (rejected.length) text.push('', '<b>أمثلة مرفوضة:</b>', ...rejected.slice(0, 3).map(r => '• صف ' + r.row + ': ' + esc(r.reason)));\nreturn [{ json: { text: text.join('\\n'), raw, noCode, clean: clean.length, merged, fixed, rejected: rejected.length, chatId: $('Config').first().json.telegramChatId } }];"
      },
