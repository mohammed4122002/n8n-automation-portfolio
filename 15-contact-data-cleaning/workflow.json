      "parameters": {
        "jsCode": "const cc = String($('Config').first().json.defaultCountryCode || '970');\nconst toLatin = s => String(s ?? '').replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d)).replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d));\nconst pick = (row, names) => { for (const k of Object.keys(row)) if (names.includes(k.trim().toLowerCase())) return row[k]; return ''; };\nconst domainFix = { 'gmial.com': 'gmail.com', 'gmai.com': 'gmail.com', 'gmail.co': 'gmail.com', 'gamil.com': 'gmail.com', 'hotmial.com': 'hotmail.com', 'hotmail.co': 'hotmail.com', 'yahho.com': 'yahoo.com', 'outlok.com': 'outlook.com' };\nconst titleCase = s => s.replace(/\\b([a-z])([a-z]*)/gi, (m, a, b) => a.toUpperCase() + b.toLowerCase());\n\nconst rows = $input.all().map((item, i) => {\n  const r = item.json, fixes = [];\n  let name = toLatin(pick(r, ['name', 'full name', 'الاسم', 'الاسم الكامل'])).trim().replace(/\\s+/g, ' ');\n  if (/[a-z]/i.test(name) && name !== titleCase(name)) { name = titleCase(name); fixes.push('name case'); }\n\n  let email = toLatin(pick(r, ['email', 'e-mail', 'البريد', 'البريد الإلكتروني'])).trim().toLowerCase().replace(/\\s+/g, '');\n  let [user, domain] = email.split('@');\n  if (domain) {\n    if (domain.endsWith('.con')) { domain = domain.slice(0, -4) + '.com'; fixes.push('.con→.com'); }\n    if (domainFix[domain]) { fixes.push(domain + '→' + domainFix[domain]); domain = domainFix[domain]; }\n    email = user + '@' + domain;\n  }\n  const emailValid = /^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/.test(email);\n\n  let digits = toLatin(pick(r, ['phone', 'mobile', 'whatsapp', 'الهاتف', 'الجوال', 'رقم الهاتف'])).replace(/\\D/g, '');\n  if (digits.startsWith('00')) digits = digits.slice(2);\n  if (digits.length === 10 && digits.startsWith('0')) { digits = cc + digits.slice(1); fixes.push('phone +' + cc); }\n  else if (digits.length === 9 && /^5/.test(digits)) { digits = cc + digits; fixes.push('phone +' + cc); }\n  const phoneValid = digits.length >= 11 && digits.length <= 15;\n  const phone = phoneValid ? '+' + digits : '';\n\n  const reasons = [];\n  if (!name) reasons.push('الاسم فارغ');\n  if (!emailValid && !phoneValid) reasons.push('لا يوجد بريد أو هاتف صالح');\n  return {\n    row: i + 2, name, email: emailValid ? email : '', phone,\n    city: String(pick(r, ['city', 'المدينة']) || '').trim(),\n    source: String(pick(r, ['source', 'المصدر']) || '').trim(),\n    notes: String(pick(r, ['notes', 'ملاحظات']) || '').trim(),\n    fixes, reasons, invalidEmail: email && !emailValid ? email : ''\n  };\n});\n\nconst valid = rows.filter(r => r.reasons.length === 0);\nconst rejected = rows.filter(r => r.reasons.length > 0);\n\nconst parent = valid.map((_, i) => i);\nconst find = i => parent[i] === i ? i : (parent[i] = find(parent[i]));\nconst seen = {};\nvalid.forEach((r, i) => {\n  for (const key of [r.email && 'e:' + r.email, r.phone && 'p:' + r.phone].filter(Boolean)) {\n    if (seen[key] === undefined) seen[key] = i; else parent[find(i)] = find(seen[key]);\n  }\n});\nconst groups = {};\nvalid.forEach((r, i) => { (groups[find(i)] = groups[find(i)] || []).push(r); });\n\nconst best = (list, f) => list.map(x => x[f]).filter(Boolean).sort((a, b) => b.length - a.length)[0] || '';\nconst uniq = (list, f) => [...new Set(list.map(x => x[f]).filter(Boolean))].join(' | ');\nconst clean = Object.values(groups).map((g, n) => ({\n  status: 'clean',\n  contactId: 'C-' + String(n + 1).padStart(4, '0'),\n  contactKey: best(g, 'email') || best(g, 'phone'),\n  name: best(g, 'name'), email: best(g, 'email'), phone: best(g, 'phone'), city: best(g, 'city'),\n  source: uniq(g, 'source'), notes: uniq(g, 'notes'),\n  mergedRows: g.map(x => x.row).join(','), mergedCount: g.length,\n  fixes: [...new Set(g.flatMap(x => x.fixes))].join(', ')\n}));\n\nreturn [\n  ...clean.map(json => ({ json })),\n  ...rejected.map(r => ({ json: { status: 'rejected', row: r.row, name: r.name, email: r.invalidEmail || r.email, phone: r.phone, reason: r.reasons.join(' + ') } }))\n];"
      },
