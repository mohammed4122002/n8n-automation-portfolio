      "id": "a16c6cd9-7550-4906-8c8e-fd7874feade2",
      "name": "Sample Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "const src = $input.first().json;\nconst exec = src.execution || {};\nconst trig = src.trigger || {};\nconst err = exec.error || trig.error || {};\nconst wf = src.workflow || {};\n\nconst message = String(err.message || err.description || 'Unknown error').slice(0, 900);\nconst failedNode = (err.node && err.node.name) || exec.lastNodeExecuted || (trig.error ? 'Trigger' : 'Unknown');\nconst workflowName = wf.name || 'Unknown workflow';\n\nconst rules = [\n  { category: 'auth', severity: 'critical', re: /\\b(401|403)\\b|unauthori[sz]ed|forbidden|invalid credentials|invalid_grant|token (has )?expired|permission/i,\n    hint: 'تحقق من بيانات الاعتماد أو أعد ربط الحساب (OAuth).' },\n  { category: 'rate_limit', severity: 'high', re: /\\b429\\b|rate.?limit|too many requests|quota/i,\n    hint: 'خفّف عدد الطلبات أو أضف Wait بين الدفعات.' },\n  { category: 'server', severity: 'high', re: /\\b5\\d\\d\\b|service unavailable|bad gateway|internal server error/i,\n    hint: 'الخدمة الخارجية متعطلة مؤقتًا؛ فعّل Retry On Fail.' },\n  { category: 'network', severity: 'medium', re: /timeout|timed out|ETIMEDOUT|ECONNRESET|ECONNREFUSED|ENOTFOUND|socket hang up/i,\n    hint: 'مشكلة اتصال أو مهلة؛ زد مهلة الطلب أو أعد المحاولة.' },\n  { category: 'data', severity: 'medium', re: /cannot read propert|undefined|is not a function|invalid json|unexpected token|required|missing|not found/i,\n    hint: 'البيانات الواردة ناقصة أو بشكل مختلف؛ راجع آخر مدخلات العقدة.' }\n];\nconst match = rules.find(r => r.re.test(message)) || { category: 'unknown', severity: 'high', hint: 'افتح التنفيذ وراجع العقدة الفاشلة.' };\n\nconst cfg = $('Config').first().json;\nconst criticalList = String(cfg.criticalWorkflows || '').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);\nlet severity = match.severity;\nif (criticalList.some(name => workflowName.toLowerCase().includes(name))) severity = 'critical';\n\nconst normalized = (workflowName + '|' + failedNode + '|' + message.toLowerCase().replace(/[0-9a-f]{8,}/g, '#').replace(/\\d+/g, '#')).slice(0, 300);\nlet hash = 5381;\nfor (let i = 0; i < normalized.length; i++) hash = ((hash << 5) + hash + normalized.charCodeAt(i)) >>> 0;\nconst fingerprint = hash.toString(16).padStart(8, '0');\n\nreturn [{ json: {\n  errorId: 'ERR-' + $now.toFormat('yyyyLLdd-HHmmss') + '-' + fingerprint.slice(0, 4),\n  time: $now.toFormat('yyyy-LL-dd HH:mm:ss'),\n  workflowName,\n  workflowId: wf.id || '',\n  executionId: exec.id || '',\n  executionUrl: exec.url || '',\n  mode: exec.mode || trig.mode || '',\n  isRetry: Boolean(exec.retryOf),\n  failedNode,\n  message,\n  category: match.category,\n  severity,\n  hint: match.hint,\n  fingerprint\n} }];"
      },
