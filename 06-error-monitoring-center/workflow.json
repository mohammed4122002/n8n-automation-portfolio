    {
      "parameters": {
        "jsCode": "const since = $now.minus({ hours: 24 });\nconst rows = $input.all().map(i => i.json).filter(r => r && r.Time).filter(r => {\n  const t = DateTime.fromFormat(String(r.Time), 'yyyy-LL-dd HH:mm:ss', { zone: $now.zoneName });\n  return t.isValid && t >= since;\n});\n\nconst count = (key) => rows.reduce((acc, r) => { const k = r[key] || 'unknown'; acc[k] = (acc[k] || 0) + 1; return acc; }, {});\nconst bySeverity = count('Severity');\nconst byWorkflow = Object.entries(count('Workflow')).sort((a, b) => b[1] - a[1]).slice(0, 5);\nconst byCategory = Object.entries(count('Category')).sort((a, b) => b[1] - a[1]);\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nlet text;\nif (rows.length === 0) {\n  text = '✅ <b>تقرير الأخطاء اليومي</b> — ' + $now.toFormat('yyyy-LL-dd') + '\\n\\nلا توجد أخطاء خلال آخر 24 ساعة. كل الـ workflows تعمل بسلام.';\n} else {\n  text = [\n    '📊 <b>تقرير الأخطاء اليومي</b> — ' + $now.toFormat('yyyy-LL-dd'),\n    '',\n    'إجمالي الأخطاء: <b>' + rows.length + '</b>',\n    '🔴 حرج: ' + (bySeverity.critical || 0) + ' | 🟠 مرتفع: ' + (bySeverity.high || 0) + ' | 🟡 متوسط: ' + (bySeverity.medium || 0),\n    '',\n    '<b>الأكثر تعطلًا:</b>',\n    ...byWorkflow.map(([wf, n], i) => (i + 1) + '. ' + esc(wf) + ' — ' + n),\n    '',\n    '<b>حسب النوع:</b> ' + byCategory.map(([c, n]) => esc(c) + ' (' + n + ')').join('، ')\n  ].join('\\n');\n}\nreturn [{ json: { text, total: rows.length, telegramChatId: $('Digest Config').first().json.telegramChatId } }];"
      },
