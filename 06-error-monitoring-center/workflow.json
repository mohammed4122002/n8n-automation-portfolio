    {
      "parameters": {
        "jsCode": "const rec = $('Normalize and Classify').first().json;\nconst cfg = $('Config').first().json;\nconst windowMin = Number(cfg.dedupeWindowMinutes) || 30;\nconst now = $now;\n\nconst previous = $input.all().map(i => i.json).filter(r => r && r.Time);\nconst recent = previous.filter(r => {\n  const t = DateTime.fromFormat(String(r.Time), 'yyyy-LL-dd HH:mm:ss', { zone: now.zoneName });\n  return t.isValid && now.diff(t, 'minutes').minutes <= windowMin;\n});\nconst occurrences = previous.length + 1;\nconst shouldAlert = recent.length === 0 || rec.severity === 'critical' && recent.length % 5 === 0;\n\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst icons = { critical: '🔴', high: '🟠', medium: '🟡', low: '🟢' };\nconst labels = { critical: 'حرج', high: 'مرتفع', medium: 'متوسط', low: 'منخفض' };\n\nconst lines = [\n  icons[rec.severity] + ' <b>تنبيه خطأ في n8n</b> | ' + labels[rec.severity],\n  '',\n  '⚙️ <b>Workflow:</b> ' + esc(rec.workflowName),\n  '🧩 <b>العقدة:</b> ' + esc(rec.failedNode),\n  '🏷️ <b>النوع:</b> ' + esc(rec.category),\n  '💬 <b>الرسالة:</b> <code>' + esc(rec.message.slice(0, 350)) + '</code>',\n  '💡 <b>اقتراح:</b> ' + esc(rec.hint),\n  '🔁 <b>تكرر:</b> ' + occurrences + ' مرة (آخر ' + windowMin + ' دقيقة: ' + (recent.length + 1) + ')',\n  '🆔 ' + esc(rec.errorId)\n];\nif (rec.executionUrl) lines.push('', '<a href=\"' + esc(rec.executionUrl) + '\">فتح التنفيذ ←</a>');\n\nconst emailHtml = '<div dir=\"rtl\" style=\"font-family:Arial,sans-serif\">' + lines.join('<br>') + '</div>';\n\nreturn [{ json: { ...rec, occurrences, recentCount: recent.length, shouldAlert, alerted: shouldAlert ? 'yes' : 'suppressed', telegramText: lines.join('\\n'), emailHtml, telegramChatId: cfg.telegramChatId, alertEmail: cfg.alertEmail } }];"
      },
