    {
      "parameters": {
        "jsCode": "const req = $('Parse Request').first().json;\nconst text = req.text.toLowerCase();\nconst terms = $input.all().map(i => i.json).filter(r => r && r.Arabic && r.English);\nconst hits = terms.filter(t => text.includes(String(t.Arabic).toLowerCase()) || text.includes(String(t.English).toLowerCase()));\nconst arabicChars = (req.text.match(/[\\u0600-\\u06FF]/g) || []).length;\nconst latinChars = (req.text.match(/[A-Za-z]/g) || []).length;\nconst detected = arabicChars >= latinChars ? 'ar' : 'other';\nconst target = req.target !== 'auto' ? req.target : (detected === 'ar' ? 'en' : 'ar');\nconst glossaryText = hits.length\n  ? hits.map(t => '- ' + t.Arabic + ' = ' + t.English + (t.Note ? ' (' + t.Note + ')' : '')).join('\\n')\n  : '(no glossary terms in this text)';\nreturn [{ json: { ...req, target, targetName: target === 'en' ? 'English' : 'Arabic (Modern Standard)', glossaryText, glossaryHits: hits.length } }];"
      },
      "id": "7ff02db9-5700-4c6a-92db-dda2d966b48e",
      "name": "Match Glossary Terms",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        480
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Target language: {{ $json.targetName }}\nTone: {{ $json.tone }}\n\nMandatory glossary (use exactly these equivalents):\n{{ $json.glossaryText }}\n\nText to translate:\n\"\"\"{{ $json.text }}\"\"\"",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a senior Arabic-English translator for business and tech content. Translate meaning, not words: natural, fluent, culturally appropriate. Keep numbers, names, URLs, emojis, hashtags and line breaks. Brand and product names stay in Latin script. Always apply the mandatory glossary. Do not add or remove information. notes: one short Arabic sentence only if something was ambiguous, otherwise an empty string."
            }
          ]
        },
        "batching": {}
      },
