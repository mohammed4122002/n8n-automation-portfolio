      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const msg = $json.message || {};\nlet text = String(msg.text || msg.caption || '').trim();\nlet target = 'auto';\nlet tone = 'professional';\n\nconst cmd = text.match(/^\\/(\\w+)(?:@\\w+)?\\s*/);\nif (cmd) {\n  const c = cmd[1].toLowerCase();\n  text = text.slice(cmd[0].length).trim();\n  if (c === 'en' || c === 'ar') target = c;\n  if (c === 'casual') tone = 'casual';\n  if (c === 'start' || c === 'help') text = '';\n}\n\nreturn { json: {\n  chatId: msg.chat ? msg.chat.id : '',\n  messageId: msg.message_id || 0,\n  user: (msg.from && (msg.from.username || msg.from.first_name)) || 'user',\n  text: text.slice(0, 6000),\n  target,\n  tone,\n  isHelp: text.length === 0\n} };"
      },
