    {
      "parameters": {
        "jsCode": "const req = $('Match Glossary Terms').first().json;\nconst tr = $('Translate').first().json.output || {};\nconst qa = $input.first().json.output || {};\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst score = Number(qa.score) || 0;\nconst finalText = (score < 8 && qa.improved_translation) ? qa.improved_translation : tr.translation;\nconst badge = score >= 9 ? '🟢' : score >= 7 ? '🟡' : '🔴';\nconst footer = [badge + ' جودة: ' + score + '/10' + (score < 8 ? ' (تم تحسينها تلقائيًا)' : '') + (req.glossaryHits ? ' · 📘 ' + req.glossaryHits + ' مصطلح من القاموس' : '')];\nif (qa.issues) footer.push('ℹ️ ' + esc(qa.issues));\nif (tr.notes) footer.push('📝 ' + esc(tr.notes));\nconst body = esc(finalText);\nconst chunks = [];\nfor (let i = 0; i < body.length; i += 3500) chunks.push(body.slice(i, i + 3500));\nchunks[chunks.length - 1] += '\\n\\n' + footer.join('\\n');\nreturn chunks.map((text, i) => ({ json: { chatId: req.chatId, replyTo: i === 0 ? req.messageId : 0, text, user: req.user, source: tr.source_language, target: req.target, chars: req.text.length, score } }));"
      },
