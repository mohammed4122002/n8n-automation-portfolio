    {
      "parameters": {
        "promptType": "define",
        "text": "=Source text:\n\"\"\"{{ $('Match Glossary Terms').item.json.text }}\"\"\"\n\nTranslation ({{ $('Match Glossary Terms').item.json.targetName }}):\n\"\"\"{{ $json.output.translation }}\"\"\"\n\nGlossary:\n{{ $('Match Glossary Terms').item.json.glossaryText }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a strict translation reviewer. Compare source and translation for accuracy, omissions, additions, glossary compliance and fluency. Score 1-10. If score < 8, return an improved translation that fixes the issues; otherwise return the translation unchanged. issues: short Arabic bullet text or empty string."
            }
          ]
        },
        "batching": {}
