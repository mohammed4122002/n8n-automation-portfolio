      "parameters": {
        "jsonSchemaExample": "{\n  \"document_type\": \"invoice\",\n  \"vendor_name\": \"Cloud Hosting LLC\",\n  \"vendor_tax_id\": \"562198341\",\n  \"invoice_number\": \"INV-2041\",\n  \"invoice_date\": \"2026-10-20\",\n  \"due_date\": \"2026-11-19\",\n  \"currency\": \"USD\",\n  \"subtotal\": 1000,\n  \"tax_rate\": 18,\n  \"tax_amount\": 180,\n  \"total\": 1180,\n  \"line_items\": [ { \"description\": \"VPS Pro plan\", \"quantity\": 1, \"unit_price\": 1000, \"amount\": 1000 } ],\n  \"confidence\": 0.95\n}"
      },
      "id": "2ae950de-2f24-4070-9e04-3f278d4d3993",
      "name": "Invoice Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1480,
        408
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const v = $json.output || {};\nconst meta = $('Split PDF Attachments').item.json;\nconst cfg = $('Config').first().json;\nconst num = x => { if (typeof x === 'number') return x; const n = parseFloat(String(x ?? '').replace(/[^\\d.-]/g, '')); return isNaN(n) ? null : n; };\nconst round = n => Math.round(n * 100) / 100;\nconst issues = [];\n\nconst subtotal = num(v.subtotal), tax = num(v.tax_amount) ?? 0, total = num(v.total);\nconst lines = Array.isArray(v.line_items) ? v.line_items : [];\nconst linesSum = round(lines.reduce((s, l) => s + (num(l.amount) ?? (num(l.quantity) ?? 1) * (num(l.unit_price) ?? 0)), 0));\nconst tol = x => Math.max(1, Math.abs(x) * 0.01);\n\nif (!v.vendor_name) issues.push('اسم المورد غير موجود');\nif (!v.invoice_number) issues.push('رقم الفاتورة غير موجود');\nif (total === null) issues.push('الإجمالي غير موجود');\nif (subtotal !== null && total !== null && Math.abs(subtotal + tax - total) > tol(total)) issues.push('المجموع الفرعي + الضريبة لا يساوي الإجمالي (' + round(subtotal + tax) + ' ≠ ' + total + ')');\nif (lines.length && subtotal !== null && Math.abs(linesSum - subtotal) > tol(subtotal)) issues.push('مجموع البنود (' + linesSum + ') لا يطابق المجموع الفرعي (' + subtotal + ')');\nconst d = DateTime.fromISO(String(v.invoice_date || ''));\nif (!d.isValid) issues.push('تاريخ الفاتورة غير صالح');\nelse if (d > $now.plus({ days: 7 })) issues.push('تاريخ الفاتورة في المستقبل');\nelse if (d < $now.minus({ years: 2 })) issues.push('الفاتورة أقدم من سنتين');\nif (total !== null && total > Number(cfg.autoApproveLimit)) issues.push('المبلغ أعلى من حد الاعتماد التلقائي (' + cfg.autoApproveLimit + ')');\nif ((num(v.confidence) ?? 0) < 0.7) issues.push('ثقة الاستخراج منخفضة');\n\nconst norm = s => String(s || '').toLowerCase().replace(/[^\\p{L}\\p{N}]+/gu, '');\nconst invoiceKey = norm(v.vendor_name) + '|' + norm(v.invoice_number);\nconst existing = new Set($('Read Existing Invoices').all().map(i => i.json['Invoice Key']).filter(Boolean));\nconst duplicate = Boolean(v.invoice_number) && existing.has(invoiceKey);\n\nconst docType = String(v.document_type || 'invoice');\nlet status = 'approved';\nif (docType === 'not_invoice') status = 'not_invoice';\nelse if (duplicate) status = 'duplicate';\nelse if (issues.length) status = 'review';\n\nconst safe = s => String(s || 'unknown').replace(/[^\\p{L}\\p{N}-]+/gu, '_').slice(0, 40);\nreturn {\n  json: {\n    ...meta,\n    invoiceKey, status, issues, issuesText: issues.join(' | '),\n    vendor: v.vendor_name || '', taxId: v.vendor_tax_id || '', invoiceNumber: v.invoice_number || '',\n    invoiceDate: v.invoice_date || '', dueDate: v.due_date || '', currency: v.currency || cfg.defaultCurrency,\n    subtotal, tax, taxRate: num(v.tax_rate), total, linesCount: lines.length,\n    itemsText: lines.map(l => l.description + ' × ' + (l.quantity ?? 1) + ' = ' + (l.amount ?? '')).join(' ; '),\n    confidence: num(v.confidence), docType,\n    archiveName: (v.invoice_date || $now.toFormat('yyyy-LL-dd')) + '_' + safe(v.vendor_name) + '_' + safe(v.invoice_number) + '.pdf'\n  },\n  binary: $('Split PDF Attachments').item.binary\n};"
      },
