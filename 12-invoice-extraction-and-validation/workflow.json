    {
      "parameters": {
        "jsCode": "const out = [];\n$('Config').all().forEach((item, idx) => {\n  const bin = item.binary || {};\n  const j = item.json;\n  for (const key of Object.keys(bin)) {\n    const b = bin[key];\n    const name = b.fileName || key;\n    const isPdf = String(b.mimeType || '').includes('pdf') || /\\.pdf$/i.test(name);\n    if (!isPdf) continue;\n    out.push({\n      json: {\n        source: j.submittedAt ? 'form' : 'email',\n        from: (j.from && (j.from.text || (j.from.value && j.from.value[0] && j.from.value[0].address))) || 'Form upload',\n        subject: j.subject || '',\n        emailId: j.id || '',\n        fileName: name,\n        receivedAt: $now.toFormat('yyyy-LL-dd HH:mm')\n      },\n      binary: { data: b },\n      pairedItem: { item: idx }\n    });\n  }\n});\nreturn out;"
      },
