      "id": "4cc23cf6-2518-4869-a204-04d2feef11d5",
      "name": "Get Absence Records",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        288,
        336
      ]
    },
    {
      "parameters": {
        "jsCode": "// Group the last 7 days of absences per student and place each one on the escalation ladder.\nconst rows = $input.all().map(i => i.json);\nconst today = $now.toFormat('yyyy-MM-dd');\nconst cutoff = $now.minus({ days: 7 }).toFormat('yyyy-MM-dd');\nconst students = {};\n\nfor (const r of rows) {\n  const d = String(r.attendance_date || '').slice(0, 10);\n  if (!r.student_name || !d || d < cutoff) continue;\n  const key = r.student_name + '|' + (r.parent_chat_id || '');\n  if (!students[key]) {\n    students[key] = {\n      student_name: r.student_name,\n      class_name: r.class_name,\n      parent_chat_id: String(r.parent_chat_id || ''),\n      dates: [],\n    };\n  }\n  if (!students[key].dates.includes(d)) students[key].dates.push(d);\n}\n\nreturn Object.values(students).map(s => {\n  const absences = s.dates.length;\n  let tier = 'gentle';\n  if (absences === 2) tier = 'concerned';\n  if (absences >= 3) tier = 'escalate';\n  return {\n    json: {\n      student_name: s.student_name,\n      class_name: s.class_name,\n      parent_chat_id: s.parent_chat_id,\n      absences,\n      absent_dates: s.dates.sort().join(', '),\n      absent_today: s.dates.includes(today),\n      tier,\n    },\n  };\n});"
      },
      "id": "d5f3811e-74fd-448f-bc89-6b7660bc2ac1",
      "name": "Build Absence Ladder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        336
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "absent-today",
              "leftValue": "={{ $json.absent_today }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5329ba5d-259c-43b9-9ebd-4fc61a494ad0",
      "name": "Only Absent Today",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.4,
