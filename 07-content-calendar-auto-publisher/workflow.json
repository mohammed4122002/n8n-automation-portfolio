    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst published = rows.filter(r => r.Status === 'published');\nconst failed = rows.filter(r => r.Status === 'failed');\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst lines = ['🗓️ <b>تقرير النشر المجدول</b> — ' + $now.toFormat('yyyy-LL-dd HH:mm'), '', '✅ نُشر: ' + published.length + ' | ❌ فشل: ' + failed.length];\nfor (const r of published) lines.push('• ' + esc(r['Post ID']) + (r['Post URL'] ? ' — <a href=\"' + esc(r['Post URL']) + '\">رابط</a>' : ''));\nfor (const r of failed) lines.push('⚠️ ' + esc(r['Post ID']) + ': ' + esc(r.Error));\nreturn [{ json: { total: rows.length, failedCount: failed.length, text: lines.join('\\n') } }];"
      },
