    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst zone = $now.zoneName;\nconst formats = ['yyyy-LL-dd HH:mm', 'yyyy-LL-dd H:mm', 'yyyy-LL-dd HH:mm:ss', 'dd/LL/yyyy HH:mm', 'd/L/yyyy H:mm'];\nconst parseDate = (value) => {\n  if (typeof value === 'number') return DateTime.fromMillis(Math.round((value - 25569) * 86400000), { zone: 'UTC' }).setZone(zone, { keepLocalTime: true });\n  const s = String(value || '').trim();\n  for (const f of formats) { const d = DateTime.fromFormat(s, f, { zone }); if (d.isValid) return d; }\n  const iso = DateTime.fromISO(s, { zone });\n  return iso.isValid ? iso : null;\n};\nconst platformMap = { linkedin: 'linkedin', 'linked in': 'linkedin', x: 'x', twitter: 'x', telegram: 'telegram' };\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst due = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!r['Post ID'] || String(r.Status || '').toLowerCase() !== 'scheduled') continue;\n  const when = parseDate(r['Publish At']);\n  if (!when || when > $now) continue;\n  const text = String(r.Text || '').trim();\n  const platform = platformMap[String(r.Platform || '').trim().toLowerCase()] || String(r.Platform || 'unknown').toLowerCase();\n  due.push({\n    postId: String(r['Post ID']),\n    platform,\n    text,\n    textHtml: esc(text),\n    publishAt: when.toFormat('yyyy-LL-dd HH:mm'),\n    charCount: text.length,\n    tooLongForX: platform === 'x' && text.length > 280,\n    emptyText: text.length === 0\n  });\n}\ndue.sort((a, b) => a.publishAt.localeCompare(b.publishAt));\nreturn due.slice(0, Number(cfg.maxPostsPerRun) || 5).map(json => ({ json }));"
      },
      "id": "85592e29-d2da-421a-977e-a0f4fb749b13",
      "name": "Pick Due Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        800
      ]
