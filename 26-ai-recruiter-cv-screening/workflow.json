            },
            {
              "id": "c13",
              "name": "interview_questions",
              "type": "string",
              "value": "={{ ($json.output.interview_questions || []).map((q, i) => (i + 1) + '. ' + q).join('\\n') }}"
            },
            {
              "id": "c14",
              "name": "cv_file_name",
              "type": "string",
              "value": "={{ $('Prepare Candidate').item.json.cv_file_name }}"
            },
            {
              "id": "c15",
              "name": "min_score",
              "type": "number",
              "value": "={{ $('Prepare Candidate').item.json.min_score }}"
            },
            {
              "id": "c16",
              "name": "status",
              "type": "string",
              "value": "={{ (Math.round(Number($json.output.score) || 0)) >= $('Prepare Candidate').item.json.min_score ? 'shortlisted' : 'new' }}"
            }
          ]
        },
        "options": {}
      },
