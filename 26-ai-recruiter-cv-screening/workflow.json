                    "option": "Full Stack Developer"
                  },
                  {
                    "option": "Digital Marketing Specialist"
                  },
                  {
                    "option": "Data Analyst"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "سنوات الخبرة",
              "fieldType": "number",
              "fieldName": "years_experience",
              "placeholder": "3",
              "requiredField": true
            },
            {
              "fieldLabel": "السيرة الذاتية (PDF)",
              "fieldType": "file",
              "fieldName": "cv",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            },
            {
              "fieldLabel": "لماذا أنت مناسب لهذه الوظيفة؟",
              "fieldType": "textarea",
              "fieldName": "cover_note",
              "placeholder": "اختياري — سطرين عنك"
