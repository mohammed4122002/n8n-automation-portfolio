        "text": "={{ (() => { const e = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); const j = $json; return '⭐ <b>مرشح مميز — ' + e(j.job_title) + '</b>\\n\\n👤 <b>' + e(j.full_name) + '</b>\\n🎯 الدرجة: <b>' + j.score + '/100</b> (' + e(j.verdict) + ')\\n🗓 الخبرة: ' + j.years_experience + ' سنوات\\n📧 ' + e(j.email) + (j.phone ? '\\n📱 ' + e(j.phone) : '') + '\\n\\n📝 ' + e(j.summary) + '\\n\\n✅ <b>نقاط القوة:</b> ' + e(j.strengths || '-') + '\\n⚠️ <b>الفجوات:</b> ' + e(j.gaps || '-') + (j.red_flags ? '\\n🚩 <b>تنبيهات:</b> ' + e(j.red_flags) : '') + '\\n🧩 <b>المهارات المطابقة:</b> ' + e(j.matched_skills || '-') + '\\n\\n🎤 <b>أسئلة مقترحة للمقابلة:</b>\\n' + e(j.interview_questions); })() }}",
