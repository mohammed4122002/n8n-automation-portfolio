    {
      "parameters": {
        "jsCode": "// Smart dedupe: same person if email OR phone matches (after normalization).\n// Keeps the newest record and fills its empty fields from older duplicates.\nconst normEmail = (e) => String(e || \"\").trim().toLowerCase();\nconst normPhone = (p) => String(p || \"\").replace(/\\D/g, \"\").replace(/^970/, \"0\");\n\nconst rows = $input.all().map((item, idx) => ({\n  idx,\n  name: String(item.json.name || \"\").trim(),\n  email: normEmail(item.json.email),\n  phone: normPhone(item.json.phone),\n  city: String(item.json.city || \"\").trim(),\n  updated_at: String(item.json.updated_at || \"\"),\n}));\n\n// Union-Find to group records that share an email or a phone\nconst parent = rows.map((_, i) => i);\nconst find = (i) => (parent[i] === i ? i : (parent[i] = find(parent[i])));\nconst union = (a, b) => { parent[find(a)] = find(b); };\nconst seen = {};\nfor (const r of rows) {\n  for (const key of [\"email:\" + r.email, \"phone:\" + r.phone]) {\n    if (key.endsWith(\":\")) continue;\n    if (seen[key] !== undefined) union(r.idx, seen[key]);\n    else seen[key] = r.idx;\n  }\n}\n\nconst groups = {};\nfor (const r of rows) {\n  const root = find(r.idx);\n  (groups[root] = groups[root] || []).push(r);\n}\n\nreturn Object.values(groups).map((group) => {\n  group.sort((a, b) => b.updated_at.localeCompare(a.updated_at));\n  const merged = { ...group[0] };\n  for (const older of group.slice(1)) {\n    for (const f of [\"name\", \"email\", \"phone\", \"city\"]) {\n      if (!merged[f] && older[f]) merged[f] = older[f];\n    }\n  }\n  delete merged.idx;\n  merged.merged_records = group.length;\n  merged.all_emails = [...new Set(group.map((g) => g.email).filter(Boolean))];\n  return { json: merged };\n});"
      },
