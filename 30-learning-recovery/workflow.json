      "position": [
        1024,
        128
      ]
    },
    {
      "parameters": {
        "defineForm": "json",
        "jsonOutput": "={{ JSON.stringify($json.formFields) }}",
        "options": {
          "formTitle": "=أسئلة {{ $(\"Diagnostic Form\").first().json.subject }}",
          "formDescription": "أجب عن كل سؤال. إن لم تعرف الإجابة اكتب: لا أعرف — هذا يساعد معلمك على اختيار الخطوة المناسبة لك.",
          "buttonLabel": "إرسال الإجابات"
        }
      },
      "id": "f35e94f7-aa3d-4143-a766-6e726b8d6aed",
      "name": "Answers Page",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        1248,
        128
      ],
      "webhookId": "3f8a0c69-0db0-4e38-a8e7-54c89811a04c"
    },
    {
      "parameters": {
        "jsCode": "const answers = $input.first().json;\nconst skills = $('Get Skills').all().map(i => i.json).filter(s => s.skill_code);\nconst form = $('Diagnostic Form').first().json;\nconst student = $('Get Student').first().json;\n\nfunction norm(v) {\n  let s = String(v === undefined || v === null ? '' : v).trim().toLowerCase();\n  s = s.replace(/[\\u0660-\\u0669]/g, d => String(d.charCodeAt(0) - 0x0660));\n  s = s.replace(/[\\u06F0-\\u06F9]/g, d => String(d.charCodeAt(0) - 0x06F0));\n  s = s.replace(/[\\u064B-\\u0652\\u0670\\u0640]/g, '');\n  s = s.replace(/[\\u0623\\u0625\\u0622]/g, '\\u0627').replace(/\\u0649/g, '\\u064A').replace(/\\u0629/g, '\\u0647');\n  s = s.replace(/[\\s\\.,;:!\\?\\u060C\\u061F\\(\\)\\-]/g, '');\n  return s;\n}\nfunction isCorrect(given, correct) {\n  const g = norm(given);\n  const c = norm(correct);\n  if (!g || !c) return false;\n  if (g === c) return true;\n  if (/^[0-9]+$/.test(c)) return g === c;\n  const trim = x => x.replace(/\\u0627$/, '');\n  if (trim(g) === trim(c)) return true;\n  return c.length >= 3 && g.includes(trim(c));\n}\nfunction findAnswer(code) {\n  if (answers[code] !== undefined) return answers[code];\n  const key = Object.keys(answers).find(k => k.startsWith(code + ' '));\n  return key ? answers[key] : '';\n}\n\nconst results = skills.map(s => {\n  const given = findAnswer(s.skill_code);\n  const ok = isCorrect(given, s.correct_answer);\n  return { skill: s, given: String(given), ok };\n});\nconst gapCodes = new Set(results.filter(r => !r.ok).map(r => r.skill.skill_code));\nconst rootGaps = results\n  .filter(r => !r.ok && !(r.skill.prerequisite_code && gapCodes.has(r.skill.prerequisite_code)))\n  .sort((a, b) => Number(a.skill.level_order) - Number(b.skill.level_order))\n  .slice(0, 3);\nconst focusText = rootGaps.map(r => r.skill.skill_code + ' ' + r.skill.skill_name).join('، ');\nconst masteredText = results.filter(r => r.ok).map(r => r.skill.skill_name).join('، ');\nconst otherGaps = results.filter(r => !r.ok && !rootGaps.includes(r)).map(r => r.skill.skill_name).join('، ');\n\nreturn results.map(r => ({ json: {\n  student_code: String(form.student_code || '').trim().toUpperCase(),\n  group_code: student.group_code || '',\n  subject: form.subject,\n  source: form.source,\n  skill_code: r.skill.skill_code,\n  skill_name: r.skill.skill_name,\n  given_answer: r.given,\n  score: r.ok ? 100 : 0,\n  mastery: r.ok ? 80 : 0,\n  status: r.ok ? 'mastered' : 'gap',\n  gap_count: gapCodes.size,\n  total_skills: results.length,\n  focus_skills: focusText,\n  mastered_skills: masteredText,\n  later_gaps: otherGaps,\n  week_start: $now.startOf('week').toISODate()\n} }));"
      },
