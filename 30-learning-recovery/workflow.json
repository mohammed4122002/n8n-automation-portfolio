      "parameters": {
        "jsCode": "const skills = $input.all().map(i => i.json).filter(s => s.skill_code);\nconst fields = skills.map(s => ({\n  fieldLabel: s.skill_code + ' — ' + s.check_question,\n  fieldName: s.skill_code,\n  fieldType: 'text',\n  requiredField: true,\n  placeholder: 'اكتب إجابتك هنا'\n}));\nreturn [{ json: { formFields: fields, skill_count: skills.length } }];"
      },
      "id": "d763e2fd-ddc1-4120-8bb0-58a0953024b7",
      "name": "Build Questions",
