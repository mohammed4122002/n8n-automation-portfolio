    {
      "parameters": {
        "jsCode": "const form = $('Exercise Form').first().json;\nconst student = $('Get Student').first().json;\nconst skills = $('Get Skill Map').all().map(i => i.json).filter(s => s.skill_code);\nconst cur = $('Get Current Mastery').first().json;\nconst recent = $('Get Recent Attempts').all().map(i => i.json).filter(r => r.skill_code);\n\nconst studentCode = String(form.student_code || '').trim().toUpperCase();\nconst skillCode = String(form.skill_code || '').trim().toUpperCase();\nconst score = Math.round(Number(String(form.score).replace(/[^0-9.]/g, '')));\nconst skill = skills.find(s => String(s.skill_code).toUpperCase() === skillCode);\n\nlet invalid = '';\nif (!student.student_code) invalid = 'رمز الطالب غير مسجّل.';\nelse if (student.guardian_consent !== true || student.active !== true) invalid = 'لا توجد موافقة ولي أمر مسجّلة لهذا الطالب.';\nelse if (!skill) invalid = 'رمز المهارة غير موجود في خريطة المهارات.';\nelse if (!isFinite(score) || score < 0 || score > 100) invalid = 'النتيجة يجب أن تكون رقمًا بين 0 و100.';\nif (invalid) return [{ json: { valid: false, invalid_reason: invalid } }];\n\nconst hasPrev = !!cur.skill_code;\nconst prev = hasPrev ? Number(cur.mastery) || 0 : null;\nconst attempts = (hasPrev ? Number(cur.attempts) || 0 : 0) + 1;\nconst mastery = prev === null ? score : Math.round(0.6 * prev + 0.4 * score);\nconst lowStreak = score < 50 ? (hasPrev ? Number(cur.low_streak) || 0 : 0) + 1 : 0;\n\nlet status = 'learning';\nif (mastery >= 80 && score >= 70) status = 'mastered';\nelse if (lowStreak >= 2) status = 'needs_help';\nelse if (mastery < 50) status = 'gap';\n\nconst prereq = skill.prerequisite_code ? skills.find(s => s.skill_code === skill.prerequisite_code) : null;\nconst nextSkill = skills\n  .filter(s => s.subject === skill.subject && Number(s.level_order) > Number(skill.level_order))\n  .sort((a, b) => Number(a.level_order) - Number(b.level_order))[0];\n\nlet nextStep = '';\nif (status === 'mastered') {\n  nextStep = nextSkill ? 'أحسنت! انتقل إلى المهارة التالية: ' + nextSkill.skill_name + ' (' + nextSkill.skill_code + ').' : 'أحسنت! أتممت كل مهارات هذه المادة في الخريطة الحالية.';\n} else if (status === 'needs_help') {\n  nextStep = 'لنأخذ استراحة من هذه المهارة. سيجلس معك معلمك قريبًا لنجرّبها بطريقة مختلفة.';\n} else if (score < 50 && prereq) {\n  nextStep = 'راجع سريعًا مهارة ' + prereq.skill_name + '، ثم جرّب تمرينًا جديدًا في ' + skill.skill_name + '.';\n} else {\n  nextStep = 'تقدّم جيد! جرّب تمرينًا آخر في ' + skill.skill_name + ' بمثال جديد.';\n}\n\nconst needsAlert = lowStreak >= 2 && (lowStreak - 2) % 3 === 0;\nconst recentScores = [score].concat(recent.map(r => Number(r.score))).join('، ');\n\nreturn [{ json: {\n  valid: true,\n  student_code: studentCode,\n  group_code: student.group_code || '',\n  skill_code: skill.skill_code,\n  skill_name: skill.skill_name,\n  subject: skill.subject,\n  prerequisite_code: prereq ? prereq.skill_code : '',\n  prerequisite_name: prereq ? prereq.skill_name : '',\n  source: form.source,\n  score: score,\n  previous_mastery: prev === null ? '' : prev,\n  mastery: mastery,\n  attempts: attempts,\n  low_streak: lowStreak,\n  status: status,\n  next_step: nextStep,\n  needs_alert: needsAlert,\n  recent_scores: recentScores\n} }];"
      },
